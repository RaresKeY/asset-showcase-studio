; Godot 4.x project settings for the reusable asset showcase studio.
; Scene-owned values in scenes/showcase_studio.tscn are the visual source of truth.

config_version=5

[application]

config/name="Asset Showcase Studio"
run/main_scene="res://scenes/showcase_studio.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012, 0.014, 0.021, 1)

[input]

toggle_ui={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
toggle_turntable={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
reverse_turntable={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
slower_turntable={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":91)]
}
faster_turntable={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":93)]
}
